# OpenAI API Settings (Required if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace API Token (Optional, for downloading gated HuggingFace models)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Model Selection
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_PROVIDER=openai  # Options: openai, huggingface, local

# Text Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Parameters
TOP_K_RESULTS=4

# Data Directories
DOCS_DIR=data/docs
VECTOR_STORE_DIR=data/vectorstore
